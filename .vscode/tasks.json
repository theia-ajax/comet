{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "(MSVC) Build Debug",
            "command": "powershell",
            "args": [
                "-ExecutionPolicy",
                "Unrestricted",
                "-NoProfile",
                "-File",
                "build.ps1",
                "-Target",
                "${config:game_target}"
            ],
            "problemMatcher": [
                "$msCompile"
            ],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": false,
                "clear": true
            }
        },
        {
            "type": "shell",
            "label": "(MSVC) Build Release",
            "command": "powershell",
            "args": [
                "-ExecutionPolicy",
                "Unrestricted",
                "-NoProfile",
                "-File",
                "build.ps1",
                "-Target",
                "${config:game_target}",
                "-Configuration",
                "Release"
            ],
            "problemMatcher": [
                "$msCompile"
            ],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": false,
                "clear": true
            },
            "group": "build"
        },
        {
            "type": "shell",
            "label": "MSVC Clean",
            "command": "powershell",
            "args": [
                "-ExecutionPolicy",
                "Unrestricted",
                "-NoProfile",
                "-File",
                "build.ps1",
                "-Target",
                "${config:game_target}",
                "-BuildAction",
                "Clean"
            ],
            "problemMatcher": [
                "$msCompile"
            ]
        },
        {
            "type": "shell",
            "label": "(GCC) Build Debug",
            "command": "./build.sh debug",
            "windows": {
                "command": ".\\build_mingw64.bat debug"
            },
            "group": "build"
        },
        {
            "type": "shell",
            "label": "(GCC) Build Release",
            "command": "./build.sh release",
            "windows": {
                "command": ".\\build_mingw64.bat release"
            },
            "group": "build"
        }
    ]
}